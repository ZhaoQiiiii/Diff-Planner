<launch>
    <arg name="drone_id" default="0"/>
    <arg name="odom_topic" default="/drone_0_visual_slam/odom"/>
    <arg name="cloud_topic" default="/mid360/points"/>
    <arg name="goal_topic" default="/diff_agent/goal"/>
    <arg name="mondify_final_goal" default="false"/>
    <arg name="sim_odom_topic" default="visual_slam/odom"/>
    <arg name="sim_init_z" default="1.0"/>

    <include file="$(find diff_planner)/launch/include/advanced_param_exp.xml">
        <arg name="drone_id" value="$(arg drone_id)"/>
        <arg name="odom_topic" value="$(arg odom_topic)"/>
        <arg name="cloud_topic" value="$(arg cloud_topic)"/>
        <arg name="goal_topic" value="$(arg goal_topic)"/>
        <arg name="mondify_final_goal" value="$(arg mondify_final_goal)"/>

        <arg name="camera_pose_topic" value="no_use0"/>
        <arg name="depth_topic" value="no_use1"/>

        <arg name="cx" value="321.04638671875"/>
        <arg name="cy" value="243.44969177246094"/>
        <arg name="fx" value="387.229248046875"/>
        <arg name="fy" value="387.229248046875"/>

        <arg name="max_vel" value="1.5"/>
        <arg name="max_acc" value="6.0"/>
        <arg name="max_jer" value="20.0"/>
        <arg name="planning_horizon" value="7.5"/>
        <arg name="local_map_size_x" value="8.0"/>
        <arg name="local_map_size_y" value="8.0"/>
        <arg name="local_map_size_z" value="4.0"/>
        <arg name="enable_virtual_wall" value="false"/>
        <arg name="virtual_ceil" value="2.0"/>
        <arg name="virtual_ground" value="-0.1"/>
        <arg name="map_resolution" value="0.1"/>
        <arg name="inflation_size" value="0.2"/>
        <arg name="init_x" value="0.0"/>
        <arg name="init_y" value="0.0"/>
        <arg name="init_z" value="0.0"/>

        <arg name="flight_type" value="1"/>
        <arg name="point_num" value="1"/>
        <arg name="point0_x" value="0.0"/>
        <arg name="point0_y" value="0.0"/>
        <arg name="point0_z" value="0.0"/>
        <arg name="point1_x" value="0.0"/>
        <arg name="point1_y" value="0.0"/>
        <arg name="point1_z" value="0.0"/>
        <arg name="point2_x" value="0.0"/>
        <arg name="point2_y" value="0.0"/>
        <arg name="point2_z" value="0.0"/>
        <arg name="point3_x" value="0.0"/>
        <arg name="point3_y" value="0.0"/>
        <arg name="point3_z" value="0.0"/>
        <arg name="point4_x" value="0.0"/>
        <arg name="point4_y" value="0.0"/>
        <arg name="point4_z" value="0.0"/>
    </include>

    <!-- Let Diff-Planner's poscmd_2_odom provide odom. -->
    <include file="$(find diff_planner)/launch/include/simulator.xml">
        <arg name="drone_id" value="$(arg drone_id)"/>
        <arg name="map_size_x_" value="200.0"/>
        <arg name="map_size_y_" value="200.0"/>
        <arg name="map_size_z_" value="3.0"/>
        <arg name="init_x_" value="0.0"/>
        <arg name="init_y_" value="0.0"/>
        <arg name="init_z_" value="$(arg sim_init_z)"/>
        <arg name="odometry_topic" value="$(arg sim_odom_topic)"/>
        <arg name="c_num" value="0"/>
        <arg name="p_num" value="0"/>
        <arg name="min_dist" value="0.0"/>
    </include>

    <node pkg="diff_planner" name="drone_$(arg drone_id)_traj_server" type="traj_server" output="screen">
        <remap from="position_cmd" to="drone_$(arg drone_id)_planning/pos_cmd"/>
        <remap from="~planning/trajectory" to="/drone_$(arg drone_id)_planning/trajectory"/>
        <remap from="~heartbeat" to="/drone_$(arg drone_id)_traj_server/heartbeat"/>
        <remap from="~odom" to="$(arg odom_topic)"/>
        <param name="traj_server/time_forward" value="1.0" type="double"/>
        <param name="traj_server/yaw_dot_max" value="3.14" type="double"/>
        <param name="traj_server/yaw_dot_dot_max" value="15.71" type="double"/>
        <!-- FOV 可视化：与 uss-nav perception_utils 的默认值一致 -->
        <param name="traj_server/fov_top_angle" value="0.6" type="double"/>
        <param name="traj_server/fov_left_angle" value="0.76" type="double"/>
        <param name="traj_server/fov_right_angle" value="0.76" type="double"/>
        <param name="traj_server/fov_vis_dist" value="1.0" type="double"/>
        <!-- 速度着色轨迹：min_speed 蓝 -> max_speed 红 -->
        <param name="traj_server/traj_min_speed" value="0.0" type="double"/>
        <param name="traj_server/traj_max_speed" value="1.5" type="double"/>
        <param name="traj_server/traj_distance_threshold" value="0.1" type="double"/>
    </node>

</launch>
